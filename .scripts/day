#!/usr/bin/env python3
"""
day_v2.py - Emacs Org-mode Time & Telemetry Manager for Kronos (v2)

Manages time.org daily entries, template expansion, task rollovers,
scheduled timestamps for Org Agenda, hierarchical category goal percentages,
food/workout log integration, and telemetry stat calculations.

Fixes in v2:
- day_v2.py start and day_v2.py end now robustly generate/update Food, Workout,
  and Stat table sections regardless of whether placeholder headers exist in time.org.
- Multi-path log auto-discovery handles food and workout logs seamlessly.

Usage:
  # Start a new day (today or yesterday)
  python3 day_v2.py start [--yesterday] [--date YYYY-MM-DD] [--file path/to/time.org]

  # End a day (today or yesterday)
  python3 day_v2.py end [--yesterday] [--date YYYY-MM-DD] [--file path/to/time.org]
"""

import os
import sys
import json
import re
import argparse
from datetime import datetime, timedelta

DEFAULT_ORG_HEADER = "#+TODO: TODO | DONEFORTODAY DONE FAILED\n"
DEFAULT_FILE_PATH = "../self-sustainer/self-manager/time/time.org"
DEFAULT_FALLBACK_BMR_KCAL = 1950.0

MONTH_MAP = {
    "January": 1, "February": 2, "March": 3, "April": 4,
    "May": 5, "June": 6, "July": 7, "August": 8,
    "September": 9, "October": 10, "November": 11, "December": 12
}


class OrgNode:
    def __init__(self, level, title, is_task=False, status=None):
        self.level = level          # 4, 5, 6, 7
        self.title = title          # Clean title
        self.is_task = is_task
        self.status = status        # "TODO", "DONEFORTODAY", "DONE", "FAILED"
        self.children = []
        self.scheduled_line = None  # Indented SCHEDULED line
        self.percentage = 0


def parse_args():
    parser = argparse.ArgumentParser(description="Kronos time.org Day Manager (day_v2.py)")

    # Common parent parser for shared arguments
    parent_parser = argparse.ArgumentParser(add_help=False)
    parent_parser.add_argument("--date", type=str, help="Target date in YYYY-MM-DD format (defaults to today)")
    parent_parser.add_argument("--yesterday", action="store_true", help="Shortcut to specify yesterday's date")
    parent_parser.add_argument("--file", type=str, default=DEFAULT_FILE_PATH, help=f"Path to time.org file (default: {DEFAULT_FILE_PATH})")
    parent_parser.add_argument("--schedules-dir", type=str, default="schedules", help="Path to schedules directory")
    parent_parser.add_argument("--logs-dir", type=str, default="logs", help="Path to logs directory")

    subparsers = parser.add_subparsers(dest="command", required=True, help="Sub-command: start or end")

    # Sub-command: start
    start_parser = subparsers.add_parser("start", parents=[parent_parser], help="Initialize a new day entry in time.org")
    start_parser.add_argument("--force", action="store_true", help="Force overwrite existing day on start")

    # Sub-command: end
    end_parser = subparsers.add_parser("end", parents=[parent_parser], help="Finalize a day entry, calculate stats & balance")
    end_parser.add_argument("--kg", type=float, help="Body weight measurement in Kg")
    end_parser.add_argument("--tobacco", type=int, help="Tobacco units consumed")
    end_parser.add_argument("--km-driven", type=float, help="Kilometers driven")
    end_parser.add_argument("--steps", type=int, help="Daily step count")
    end_parser.add_argument("--sleep-hrs", type=float, help="Hours slept")

    return parser.parse_args()


def get_date_info(args):
    if args.yesterday:
        dt = datetime.now() - timedelta(days=1)
    elif args.date:
        dt = datetime.strptime(args.date, "%Y-%m-%d")
    else:
        dt = datetime.now()

    year_str = dt.strftime("%Y")
    month_name = dt.strftime("%B")
    day_name = dt.strftime("%A")
    date_formatted = dt.strftime("%Y-%m-%d")
    short_day = dt.strftime("%a")
    day_header_str = f"*** <{date_formatted} {short_day}>"
    return dt, year_str, month_name, day_name, date_formatted, short_day, day_header_str


def ensure_org_header(content):
    if "#+TODO:" not in content:
        return DEFAULT_ORG_HEADER + "\n" + content
    else:
        def replace_todo_line(match):
            return "#+TODO: TODO | DONEFORTODAY DONE FAILED"
        return re.sub(r"#\+TODO:.*", replace_todo_line, content)


def load_json_file(filepath):
    if not os.path.exists(filepath):
        return None
    with open(filepath, "r", encoding="utf-8") as f:
        return json.load(f)


def process_logs_for_date(date_formatted, logs_dir, org_file_path):
    """
    Search multiple candidate paths for food and workout logs and extract data.
    """
    candidate_log_dirs = [
        logs_dir,
        "logs",
        "/workspace/knowledge",
        os.path.join(os.path.dirname(org_file_path), "logs") if os.path.dirname(org_file_path) else "logs"
    ]

    food_data = None
    food_log_names = [f"food-log-{date_formatted}.json", f"food_log_{date_formatted}.json", f"food-log-{date_formatted}.json.txt"]
    for d in candidate_log_dirs:
        for fname in food_log_names:
            fpath = os.path.join(d, fname)
            if os.path.exists(fpath):
                food_data = load_json_file(fpath)
                if food_data:
                    break
        if food_data:
            break

    food_kcal_intake = 0.0
    food_lines = []
    if food_data:
        meals = food_data.get("meals", [])
        for m in meals:
            m_name = m.get("meal_name", "Meal")
            m_kcal = m.get("calories_kcal", 0.0)
            food_lines.append(f"     - {m_name} ({m_kcal:.0f}kCal)")
        if "total" in food_data and "calories_kcal" in food_data["total"]:
            food_kcal_intake = food_data["total"]["calories_kcal"]
        else:
            food_kcal_intake = sum(m.get("calories_kcal", 0.0) for m in meals)

    workout_data = None
    workout_log_names = [f"workout-log-{date_formatted}.json", f"workout_log_{date_formatted}.json", f"workout-log-{date_formatted}.json.txt"]
    for d in candidate_log_dirs:
        for fname in workout_log_names:
            fpath = os.path.join(d, fname)
            if os.path.exists(fpath):
                workout_data = load_json_file(fpath)
                if workout_data:
                    break
        if workout_data:
            break

    workout_kcal_burn = 0.0
    workout_duration_min = 0
    workout_lines = []
    log_weight_kg = None
    log_steps = None
    bmr_kcal = DEFAULT_FALLBACK_BMR_KCAL

    if workout_data:
        athlete = workout_data.get("athlete", {})
        log_weight_kg = athlete.get("weight_kg")
        if athlete.get("bmr_kcal") is not None:
            bmr_kcal = float(athlete.get("bmr_kcal"))

        log_steps = workout_data.get("daily_step_count")

        workouts_list = workout_data.get("workouts", [])
        for w in workouts_list:
            w_type = w.get("type", "workout")
            w_dur = w.get("duration_minutes", 0)
            workout_duration_min += w_dur
            est_burn = w.get("estimated_calorie_burn", {})
            w_kcal = est_burn.get("gross_kcal", est_burn.get("net_kcal", 0))
            workout_lines.append(f"     - {w_type} ({w_dur} min, {w_kcal} kCal)")

        total_active = workout_data.get("total_daily_active_calories", {})
        workout_kcal_burn = total_active.get("gross_total_kcal", 0.0)
        if not workout_kcal_burn:
            workout_kcal_burn = sum(w.get("estimated_calorie_burn", {}).get("gross_kcal", 0) for w in workouts_list)

    return food_kcal_intake, food_lines, workout_kcal_burn, workout_duration_min, workout_lines, log_weight_kg, log_steps, bmr_kcal


def find_previous_day_rollovers(content, current_date_str):
    """
    Finds the last recorded day before current_date_str in content,
    and extracts tasks in 'ToDos for the day' marked DONEFORTODAY or FAILED.
    """
    day_blocks = list(re.finditer(r"^\*\*\* <(\d{4}-\d{2}-\d{2}) [^>]+>", content, re.MULTILINE))
    if not day_blocks:
        return []

    prev_block_content = None
    for i in range(len(day_blocks) - 1, -1, -1):
        match = day_blocks[i]
        b_date = match.group(1)
        if b_date < current_date_str:
            start_pos = match.start()
            end_pos = day_blocks[i+1].start() if i + 1 < len(day_blocks) else len(content)
            prev_block_content = content[start_pos:end_pos]
            break

    if not prev_block_content:
        return []

    todos_for_day_match = re.search(r"\*\*\*\*\*\* ToDos for the day.*?(?=\n\*\*\*\*\*\* |\n\*\*\*\*\* |\n\*\*\*\* |\Z)", prev_block_content, re.DOTALL)
    if not todos_for_day_match:
        return []

    sec_text = todos_for_day_match.group(0)
    rollover_items = []

    pattern = r"^\*+\s+(DONEFORTODAY|FAILED)\s+(.+)$"
    for line in sec_text.splitlines():
        line_clean = line.strip()
        m = re.match(pattern, line_clean)
        if m:
            task_name = m.group(2).strip()
            if not task_name.startswith("SCHEDULED:"):
                rollover_items.append(task_name)

    return rollover_items


def build_todo_entry(task_name, date_formatted, short_day, depth=7):
    stars = "*" * depth
    indent = " " * (depth + 1)
    return f"{stars} TODO {task_name}\n{indent}SCHEDULED: <{date_formatted} {short_day}>"


def parse_todo_tree(todo_text):
    lines = todo_text.splitlines()
    root = None
    stack = []

    i = 0
    while i < len(lines):
        line = lines[i]

        m_head = re.match(r"^(\*+)\s+(.+)$", line)
        if m_head:
            stars = m_head.group(1)
            level = len(stars)
            rest = m_head.group(2)

            m_task = re.match(r"^(TODO|DONEFORTODAY|DONE|FAILED)\s+(.+)$", rest)
            if m_task:
                status = m_task.group(1)
                task_name = m_task.group(2).strip()
                node = OrgNode(level, task_name, is_task=True, status=status)

                if i + 1 < len(lines) and "SCHEDULED:" in lines[i+1]:
                    i += 1
                    node.scheduled_line = lines[i]
            else:
                clean_title = re.sub(r"\s*\[\d+%\]$", "", rest).strip()
                node = OrgNode(level, clean_title, is_task=False)

            if not root and level == 4:
                root = node
                stack = [(4, root)]
            else:
                while stack and stack[-1][0] >= level:
                    stack.pop()
                if stack:
                    stack[-1][1].children.append(node)
                stack.append((level, node))
        i += 1

    return root


def calculate_node_percentages(node):
    if not node or node.is_task:
        return 100 if node and node.status in ("DONE", "DONEFORTODAY") else 0

    if not node.children:
        node.percentage = 0
        return 0

    child_tasks = [c for c in node.children if c.is_task]
    child_categories = [c for c in node.children if not c.is_task]

    if child_tasks and not child_categories:
        total = len(child_tasks)
        done = sum(1 for t in child_tasks if t.status in ("DONE", "DONEFORTODAY"))
        node.percentage = round((done / total) * 100) if total > 0 else 0
    elif child_categories:
        sub_pcts = [calculate_node_percentages(c) for c in child_categories]
        for t in child_tasks:
            sub_pcts.append(100 if t.status in ("DONE", "DONEFORTODAY") else 0)

        node.percentage = round(sum(sub_pcts) / len(sub_pcts)) if sub_pcts else 0
    else:
        node.percentage = 0

    return node.percentage


def render_todo_tree(node):
    if not node:
        return []
    lines = []
    stars = "*" * node.level
    if node.is_task:
        lines.append(f"{stars} {node.status} {node.title}")
        if node.scheduled_line:
            lines.append(node.scheduled_line)
    else:
        lines.append(f"{stars} {node.title} [{node.percentage}%]")
        for child in node.children:
            lines.extend(render_todo_tree(child))
    return lines


def process_todo_block_percentages(todo_text):
    tree = parse_todo_tree(todo_text)
    if tree:
        pct = calculate_node_percentages(tree)
        rendered_todo_lines = render_todo_tree(tree)
        return "\n".join(rendered_todo_lines), pct
    return todo_text, 0


def build_day_start_block(date_info, daily_sched, weekly_sched, rollovers, logs_dir, org_file_path):
    dt, year_str, month_name, day_name, date_formatted, short_day, day_header_str = date_info

    lines = [day_header_str]
    lines.append("**** ToDo [0%]")

    # Routine section
    lines.append("***** Routine [0%]")
    routine_dict = daily_sched.get("Routine", {})
    for subcat, tasks in routine_dict.items():
        lines.append(f"****** {subcat} [0%]")
        for task in tasks:
            lines.append(build_todo_entry(task, date_formatted, short_day, depth=7))

    # Outside activities
    lines.append("***** Outside activities [0%]")
    outside_tasks = weekly_sched.get(day_name, [])
    if outside_tasks:
        for task in outside_tasks:
            lines.append(build_todo_entry(task, date_formatted, short_day, depth=6))

    # Current ToDos section
    lines.append("***** Current ToDos [0%]")
    lines.append("****** ToDos for the day [0%]")
    for r_task in rollovers:
        lines.append(build_todo_entry(r_task, date_formatted, short_day, depth=7))

    current_todos = daily_sched.get("Current ToDos", {})
    for subcat, tasks in current_todos.items():
        if subcat == "ToDos for the day":
            for task in tasks:
                if task not in rollovers:
                    lines.append(build_todo_entry(task, date_formatted, short_day, depth=7))
        else:
            lines.append(f"****** {subcat} [0%]")
            for task in tasks:
                lines.append(build_todo_entry(task, date_formatted, short_day, depth=7))

    raw_todo_text = "\n".join(lines[1:])
    todo_text_rendered, goals_pct = process_todo_block_percentages(raw_todo_text)

    # Process logs if available at day-start
    food_kcal_intake, food_lines, workout_kcal_burn, workout_duration_min, workout_lines, log_weight_kg, log_steps, bmr_kcal = process_logs_for_date(date_formatted, logs_dir, org_file_path)

    food_header = f"**** Food [{food_kcal_intake:.0f}kCal]"
    food_section_content = food_header + "\n" + "\n".join(food_lines) if food_lines else food_header

    workout_header = f"**** Workout [{workout_kcal_burn:.0f}kCal]"
    workout_section_content = workout_header + "\n" + "\n".join(workout_lines) if workout_lines else workout_header

    total_expenditure = workout_kcal_burn + bmr_kcal
    kcal_balance = round(food_kcal_intake - total_expenditure)
    kg_val = log_weight_kg if log_weight_kg is not None else 0.0
    steps_val = log_steps if log_steps is not None else 0

    stat_table_str = (
        "**** Stat table\n"
        "     |------+---------+-----------+-------+-----------+-------------+---------+--------------|\n"
        "     |   Kg | Tobacco | Km driven | Steps | Sleep hrs | Workout min | Goals % | kCal balance |\n"
        "     |------+---------+-----------+-------+-----------+-------------+---------+--------------|\n"
        f"     | {kg_val:4.1f} |       0 |       0.0 | {steps_val:5d} |       0.0 | {workout_duration_min:11d} | {goals_pct:7d} | {kcal_balance:12d} |\n"
        "     |------+---------+-----------+-------+-----------+-------------+---------+--------------|"
    )

    final_lines = [day_header_str, todo_text_rendered, food_section_content, workout_section_content, stat_table_str]
    return "\n".join(final_lines) + "\n"


def insert_day_start_into_org(content, day_block, date_info, force=False):
    """
    Inserts day_block into content maintaining strict ascending chronological order:
    Year (ascending) -> Month (ascending) -> Day (ascending).
    """
    dt, year_str, month_name, day_name, date_formatted, short_day, day_header_str = date_info
    content = ensure_org_header(content)

    pattern_day = r"^\*\*\* <" + re.escape(date_formatted) + r" [^>]+>"
    day_match = re.search(pattern_day, content, re.MULTILINE)

    if day_match:
        if not force:
            print(f"Warning: Entry for {date_formatted} already exists in file. Use --force to overwrite.")
            return content
        else:
            pattern_full_day = re.escape(day_match.group(0)) + r".*?(?=\n\*\*\* <|\n\*\* |\n\* |\Z)"
            content = re.sub(pattern_full_day, "", content, flags=re.DOTALL)

    year_header = f"* {year_str}"
    month_header = f"** {month_name}"
    target_year = int(year_str)
    target_month_num = MONTH_MAP.get(month_name, 1)

    year_matches = list(re.finditer(r"^\* (\d{4})", content, re.MULTILINE))

    year_pos = -1
    year_end_pos = len(content)

    for i, m in enumerate(year_matches):
        y_val = int(m.group(1))
        if y_val == target_year:
            year_pos = m.start()
            year_end_pos = year_matches[i+1].start() if i + 1 < len(year_matches) else len(content)
            break
        elif y_val > target_year:
            insert_pos = m.start()
            new_section = f"{year_header}\n{month_header}\n{day_block.strip()}\n\n"
            return content[:insert_pos] + new_section + content[insert_pos:]

    if year_pos == -1:
        new_section = f"{year_header}\n{month_header}\n{day_block.strip()}\n"
        content_clean = content.rstrip()
        return (content_clean + "\n\n" + new_section) if content_clean else (DEFAULT_ORG_HEADER + "\n" + new_section)

    year_text = content[year_pos:year_end_pos]
    month_matches = list(re.finditer(r"^\*\* ([A-Za-z]+)", year_text, re.MULTILINE))

    month_pos_in_year = -1
    month_end_pos_in_year = len(year_text)

    for i, m in enumerate(month_matches):
        m_name = m.group(1)
        m_num = MONTH_MAP.get(m_name, 0)
        if m_num == target_month_num:
            month_pos_in_year = m.start()
            month_end_pos_in_year = month_matches[i+1].start() if i + 1 < len(month_matches) else len(year_text)
            break
        elif m_num > target_month_num:
            insert_pos = year_pos + m.start()
            new_month_block = f"{month_header}\n{day_block.strip()}\n\n"
            return content[:insert_pos] + new_month_block + content[insert_pos:]

    if month_pos_in_year == -1:
        insert_pos = year_pos + year_end_pos if year_end_pos <= len(year_text) else year_pos + len(year_text)
        new_month_block = f"{month_header}\n{day_block.strip()}\n"
        return content[:insert_pos].rstrip() + "\n\n" + new_month_block + content[insert_pos:]

    month_text = year_text[month_pos_in_year:month_end_pos_in_year]
    existing_days = list(re.finditer(r"^\*\*\* <(\d{4}-\d{2}-\d{2}) [^>]+>", month_text, re.MULTILINE))

    abs_month_start = year_pos + month_pos_in_year

    for m in existing_days:
        e_date = m.group(1)
        if e_date > date_formatted:
            insert_pos = abs_month_start + m.start()
            return content[:insert_pos] + day_block.strip() + "\n\n" + content[insert_pos:]

    abs_month_end = year_pos + month_pos_in_year + month_end_pos_in_year
    return content[:abs_month_end].rstrip() + "\n\n" + day_block.strip() + "\n\n" + content[abs_month_end:]


def update_day_sections(day_block, todo_rendered_text, food_section_content, workout_section_content, stat_table_str):
    """
    Robustly updates or inserts Food, Workout, and Stat table sections into day_block.
    """
    if todo_rendered_text:
        if re.search(r"^\*\*\*\* ToDo", day_block, re.MULTILINE):
            pattern_todo = r"(\*\*\*\* ToDo.*?)((?=\n\*\*\*\* (?:Food|Workout|Stat table))|\Z)"
            day_block = re.sub(pattern_todo, todo_rendered_text.strip(), day_block, count=1, flags=re.DOTALL)
        else:
            day_block = day_block.strip() + "\n" + todo_rendered_text.strip() + "\n"

    # Food section update/insertion
    if re.search(r"^\*\*\*\* Food", day_block, re.MULTILINE):
        pattern_food = r"(\*\*\*\* Food.*?)((?=\n\*\*\*\* (?:Workout|Stat table))|\Z)"
        day_block = re.sub(pattern_food, food_section_content.strip(), day_block, count=1, flags=re.DOTALL)
    else:
        if re.search(r"^\*\*\*\* Workout", day_block, re.MULTILINE):
            day_block = re.sub(r"(\n\*\*\*\* Workout)", "\n" + food_section_content.strip().replace('\\', '\\\\') + r"\1", day_block, count=1)
        elif re.search(r"^\*\*\*\* Stat table", day_block, re.MULTILINE):
            day_block = re.sub(r"(\n\*\*\*\* Stat table)", "\n" + food_section_content.strip().replace('\\', '\\\\') + r"\1", day_block, count=1)
        else:
            day_block = day_block.strip() + "\n" + food_section_content.strip() + "\n"

    # Workout section update/insertion
    if re.search(r"^\*\*\*\* Workout", day_block, re.MULTILINE):
        pattern_workout = r"(\*\*\*\* Workout.*?)((?=\n\*\*\*\* Stat table)|\Z)"
        day_block = re.sub(pattern_workout, workout_section_content.strip(), day_block, count=1, flags=re.DOTALL)
    else:
        if re.search(r"^\*\*\*\* Stat table", day_block, re.MULTILINE):
            day_block = re.sub(r"(\n\*\*\*\* Stat table)", "\n" + workout_section_content.strip().replace('\\', '\\\\') + r"\1", day_block, count=1)
        else:
            day_block = day_block.strip() + "\n" + workout_section_content.strip() + "\n"

    # Stat table update/insertion
    if re.search(r"^\*\*\*\* Stat table", day_block, re.MULTILINE):
        pattern_stat = r"(\*\*\*\* Stat table.*?)(\Z)"
        day_block = re.sub(pattern_stat, stat_table_str.strip(), day_block, count=1, flags=re.DOTALL)
    else:
        day_block = day_block.strip() + "\n" + stat_table_str.strip() + "\n"

    return day_block.strip() + "\n"


def finalize_day_end(content, date_info, logs_dir, args):
    dt, year_str, month_name, day_name, date_formatted, short_day, day_header_str = date_info

    pattern_day = r"^\*\*\* <" + re.escape(date_formatted) + r" [^>]+>"
    match_header = re.search(pattern_day, content, re.MULTILINE)

    if not match_header:
        print(f"Error: Entry for {date_formatted} not found in org file.")
        return content

    start_pos = match_header.start()
    next_match = re.search(r"^\*(?:\*\*? <|\*? )", content[start_pos + len(match_header.group(0)):], re.MULTILINE)
    if next_match:
        end_pos = start_pos + len(match_header.group(0)) + next_match.start()
    else:
        end_pos = len(content)

    day_block = content[start_pos:end_pos]

    # 1. Calculate Hierarchical Goal Percentages
    todo_match = re.search(r"(\*\*\*\* ToDo.*?)((?=\n\*\*\*\* (?:Food|Workout|Stat table))|\Z)", day_block, re.DOTALL)
    goals_pct = 0
    rendered_todo_text = None
    if todo_match:
        tree = parse_todo_tree(todo_match.group(1))
        if tree:
            goals_pct = calculate_node_percentages(tree)
            rendered_todo_lines = render_todo_tree(tree)
            rendered_todo_text = "\n".join(rendered_todo_lines)

    # 2. Process Logs & Telemetry
    food_kcal_intake, food_lines, workout_kcal_burn, workout_duration_min, workout_lines, log_weight_kg, log_steps, bmr_kcal = process_logs_for_date(date_formatted, logs_dir, args.file)

    # 3. Calorie Balance
    total_expenditure = workout_kcal_burn + bmr_kcal
    kcal_balance = round(food_kcal_intake - total_expenditure)

    # 4. Telemetry Inputs
    kg_val = args.kg if args.kg is not None else (log_weight_kg if log_weight_kg is not None else 0.0)
    tobacco_val = args.tobacco if args.tobacco is not None else 0
    km_val = args.km_driven if args.km_driven is not None else 0.0
    steps_val = args.steps if args.steps is not None else (log_steps if log_steps is not None else 0)
    sleep_val = args.sleep_hrs if args.sleep_hrs is not None else 0.0

    if sys.stdin.isatty():
        print(f"\n--- Entering Telemetry Data for {date_formatted} ---")
        try:
            if args.kg is None and log_weight_kg is None:
                inp = input("Weight (Kg): ").strip()
                if inp: kg_val = float(inp)
            if args.tobacco is None:
                inp = input("Tobacco units: ").strip()
                if inp: tobacco_val = int(inp)
            if args.km_driven is None:
                inp = input("Km driven: ").strip()
                if inp: km_val = float(inp)
            if args.steps is None and log_steps is None:
                inp = input("Steps count: ").strip()
                if inp: steps_val = int(inp)
            if args.sleep_hrs is None:
                inp = input("Sleep (hrs): ").strip()
                if inp: sleep_val = float(inp)
        except ValueError as e:
            print(f"Input error: {e}. Falling back to default values.")

    # 5. Format section contents
    food_header = f"**** Food [{food_kcal_intake:.0f}kCal]"
    food_section_content = food_header + "\n" + "\n".join(food_lines) if food_lines else food_header

    workout_header = f"**** Workout [{workout_kcal_burn:.0f}kCal]"
    workout_section_content = workout_header + "\n" + "\n".join(workout_lines) if workout_lines else workout_header

    stat_table_str = (
        "**** Stat table\n"
        "     |------+---------+-----------+-------+-----------+-------------+---------+--------------|\n"
        "     |   Kg | Tobacco | Km driven | Steps | Sleep hrs | Workout min | Goals % | kCal balance |\n"
        "     |------+---------+-----------+-------+-----------+-------------+---------+--------------|\n"
        f"     | {kg_val:4.1f} | {tobacco_val:7d} | {km_val:9.1f} | {steps_val:5d} | {sleep_val:9.1f} | {workout_duration_min:11d} | {goals_pct:7d} | {kcal_balance:12d} |\n"
        "     |------+---------+-----------+-------+-----------+-------------+---------+--------------|"
    )

    day_block = update_day_sections(day_block, rendered_todo_text, food_section_content, workout_section_content, stat_table_str)

    content = content[:start_pos] + day_block + content[end_pos:]
    return content


def main():
    args = parse_args()
    date_info = get_date_info(args)

    org_file_path = args.file
    if not os.path.exists(org_file_path):
        parent_dir = os.path.dirname(org_file_path)
        if parent_dir and not os.path.exists(parent_dir):
            os.makedirs(parent_dir, exist_ok=True)
        print(f"Org file '{org_file_path}' not found. Creating a new org file.")
        content = DEFAULT_ORG_HEADER
    else:
        with open(org_file_path, "r", encoding="utf-8") as f:
            content = f.read()

    if args.command == "start":
        daily_sched_path = os.path.join(args.schedules_dir, "daily-schedule.json")
        weekly_sched_path = os.path.join(args.schedules_dir, "weekly-schedule.json")

        daily_sched = load_json_file(daily_sched_path)
        if not daily_sched:
            daily_sched = load_json_file("/workspace/knowledge/daily-schedule.json.txt") or {}

        weekly_sched = load_json_file(weekly_sched_path)
        if not weekly_sched:
            weekly_sched = load_json_file("/workspace/knowledge/weekly-schedule.json.txt") or {}

        rollovers = find_previous_day_rollovers(content, date_info[4])
        if rollovers:
            print(f"  Rolled over {len(rollovers)} task(s) from previous day: {', '.join(rollovers)}")

        day_block = build_day_start_block(date_info, daily_sched, weekly_sched, rollovers, args.logs_dir, org_file_path)
        new_content = insert_day_start_into_org(content, day_block, date_info, force=args.force)

        with open(org_file_path, "w", encoding="utf-8") as f:
            f.write(new_content)
        print(f"✓ Day-start initialized for {date_info[4]} ({date_info[3]}) in '{org_file_path}'.")

    elif args.command == "end":
        new_content = finalize_day_end(content, date_info, args.logs_dir, args)
        with open(org_file_path, "w", encoding="utf-8") as f:
            f.write(new_content)
        print(f"✓ Day-end stats & calorie balance calculated for {date_info[4]} in '{org_file_path}'.")


if __name__ == "__main__":
    main()
